#!/bin/bash

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

ENTRYPOINT="/app"

# PYTHON_IMAGE_VERSION set in the environment overrides the value in .stack
PYTHON_IMAGE_VERSION_OVERRIDE=${PYTHON_IMAGE_VERSION:-}
source ${SCRIPT_DIR}/.stack
PYTHON_IMAGE_VERSION=${PYTHON_IMAGE_VERSION_OVERRIDE:-${PYTHON_IMAGE_VERSION}}

usage(){
	printf "Usage: ./stack <command> [arguments]\n"
	printf "\t build [stage] \t: Build image (stage: dev (default) | common).\n"
	printf "\t up [target] \t: Deploy container with deployments/config-<target>.env (default: local).\n"
	printf "\t down \t\t: Destroy container.\n"
	printf "\t exec \t\t: Open terminal exec inside container.\n"
	printf "\t run <command> \t: Run command inside container.\n"
	printf "\t test [args] \t: Run pytest inside container.\n"
	printf "\t ruff [args] \t: Run ruff check --fix inside container.\n"
	printf "\t format [args] \t: Run ruff format inside container.\n"
	printf "\t mypy [args] \t: Run mypy inside container.\n"
	printf "\t docs [args] \t: Build documentation into site/ inside container.\n"
	printf "\t lock \t\t: Update uv.lock inside container.\n"
	printf "Set PYTHON_IMAGE_VERSION in the environment to override the value in .stack.\n"
}

# Build image asignning IMAGE_NAME, PYTHON_IMAGE_VERSION and ENTRYPOINT variables
# IMAGE_NAME and PYTHON_IMAGE_VERSION are defined in .stack file; PYTHON_IMAGE_VERSION can be
# overridden from the environment
# ENTRYPOINT is defined at the beginning of this script
build_image(){
	stage=${1:-"dev"}
	docker build \
		--build-arg ENTRYPOINT=${ENTRYPOINT} \
		--build-arg PYTHON_IMAGE_VERSION=${PYTHON_IMAGE_VERSION} \
		-t ${IMAGE_NAME} \
		--target ${stage} \
		${SCRIPT_DIR}
}

# Start and stop container
# Usage: start_or_stop_container <up|down> [target]
#   up   : Start container
#   down : Stop container
#   target : Deployment target (default: local)	
# Following environmental variables are used from deployments/config-<target>.env file:
#   CONTAINER_NAME : Name of the container
#   EXPOSED_PORT  : Port exposed on the host machine
#   CONTAINER_PORT: Port used inside the container
# The project is mounted at ENTRYPOINT; the anonymous volume on ENTRYPOINT/.venv keeps the
# virtual environment built in the image instead of the host one.
start_or_stop_container() {
    local action=$1
	local target=${2:-"local"}

    if [[ "${action}" == "up" ]]; then

		env_file=${SCRIPT_DIR}/deployments/config-${target}.env
		if [ ! -f ${env_file} ]; then
			echo "Error: Environment file ${env_file} not found!"
			exit 1
		fi
		source ${env_file}
	
		docker rm -f ${CONTAINER_NAME} &> /dev/null # Purge before launch
		printf "Deploying ${CONTAINER_NAME} container...\n"
		docker run -d -it \
			--name "${CONTAINER_NAME}" \
			-v ${SCRIPT_DIR}:${ENTRYPOINT} \
			-v ${ENTRYPOINT}/.venv \
			-p ${EXPOSED_PORT}:${CONTAINER_PORT} \
			--user $(id -u):$(id -g) \
			--env-file ${SCRIPT_DIR}/deployments/config-${target}.env \
			${IMAGE_NAME} bash \
			|| exit 1

		until [ "`docker inspect -f {{.State.Status}} ${CONTAINER_NAME}`" == "running" ]; do
			sleep 0.5;
		done;

	elif [[ "${action}" == "down" ]]; then
		docker rm -f ${CONTAINER_NAME} &> /dev/null # Purge before launch
	else
		echo "Error: action (allowed values: up, down) can't be empty."
	fi
}

# Start shell inside the container
# Following environmental variables are used from deployments/config-<target>.env file:
#   CONTAINER_NAME : Name of the container
launch_exec(){
	docker exec -it $CONTAINER_NAME sh
}

# Run bash command inside the container
#	parameters: Command to be executed inside the container
# Following environmental variables are used from deployments/config-<target>.env file:
#   CONTAINER_NAME : Name of the container
run_exec(){
	parameters=${@}
	docker exec $CONTAINER_NAME bash -c "${parameters}"
}


run_pytest(){
	parameters=${@}
	docker exec $CONTAINER_NAME bash -c "pytest ${parameters}"
}

lock(){
	parameters=${@}
	docker exec $CONTAINER_NAME bash -c "uv lock"
}

run_ruff(){
	parameters=${@}
	docker exec $CONTAINER_NAME bash -c "RUFF_CACHE_DIR=/tmp/ruff-cache ruff check --fix ${parameters}"
}

run_mypy(){
	parameters=${@}
	docker exec $CONTAINER_NAME bash -c "MYPY_CACHE_DIR=/tmp/mypy-cache mypy ${parameters}"
}

run_docs(){
	parameters=${@}
	docker exec $CONTAINER_NAME bash -c "mkdocs build --strict ${parameters}"
}

run_format(){
	parameters=${@}
	docker exec $CONTAINER_NAME bash -c "RUFF_CACHE_DIR=/tmp/ruff-cache ruff format ${parameters}"
}


case "$1" in

    build)
		build_image "${@:2}"
		;;
	up | down)
        start_or_stop_container "${@:1}"
		;;
	exec)
		launch_exec
		;;
	run)
		run_exec "${@:2}"
		;;
	test)
		run_pytest "${@:2}"
		;;
	lock)
		lock "${@:2}"
		;;
	ruff)
		run_ruff "${@:2}"
		;;
	format)
		run_format "${@:2}"
		;;
	mypy)
		run_mypy "${@:2}"
		;;
	docs)
		run_docs "${@:2}"
		;;
	* | -h | help)
		usage
		;;
esac
